@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 180
entity "client (FK target)" as client {
  *id : bigint <<PK>>
}
entity "vehicle (FK target)" as vehicle {
  *id : bigint <<PK>>
}
entity "test_drive" as td {
  *id : bigint <<PK>>
  *vehicle : bigint <<FK>>
  *client : bigint <<FK>>
  *date : timestamp
}
entity "rent" as rent {
  *id : bigint <<PK>>
  *vehicle : bigint <<FK>>
  *client : bigint <<FK>>
  *amount : decimal(10,2)
  *start : date
  *end : date
}
client ||--o{ td
client ||--o{ rent
vehicle ||--o{ td
vehicle ||--o{ rent
@enduml
