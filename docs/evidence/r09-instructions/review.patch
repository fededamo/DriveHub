+    totals=dict.fromkeys(['tests','failures','errors','skipped'],0)
+    for p in sorted((repo/'target/surefire-reports').glob('TEST-*.xml')):
+        tree=ET.parse(p)
+        for key in totals: totals[key]+=int(tree.getroot().attrib[key])
