        <mxCell id="discount" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;domain.discount&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;Sconti modello / veicolo&lt;br&gt;Percentuale intera 0–50&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
