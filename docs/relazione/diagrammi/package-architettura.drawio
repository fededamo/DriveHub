        <mxCell id="domains" value="Dominio — quattro package distinti, senza dipendenze fra loro" style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontStyle=1;spacing=4;html=1;" vertex="1" parent="1">
