        <mxCell id="operation" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;domain.operation&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;Richieste, registro, noleggi&lt;br&gt;Test drive; riferimenti per ID&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="530" y="1130" width="490" height="120" />
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Lettura della tavola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;Dipendenze trasversali effettive (→ indica il fornitore):&lt;br&gt;it.unifi.drivehub → dao.postgres, dao, event, security, domain.user, oltre agli archi sopra.&lt;br&gt;presentation.view → it.unifi.drivehub (overload globali) e i quattro package domain.&lt;br&gt;service, dao e dao.postgres → ciascuno dei quattro package domain.&lt;br&gt;Nessuna dipendenza del dominio da servizi/DAO/JavaFX; event usa java.sql.Connection.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1290" width="1000" height="205" />
