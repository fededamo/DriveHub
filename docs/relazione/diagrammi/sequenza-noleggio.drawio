    <mxCell id="v46" value="ref SQ-OB · Cancella tutti i test drive futuri del veicolo su c5, anche fuori periodo. Ritorno → commit/chiusura c5 → Rent alla vista; stato del veicolo resta RENT." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
