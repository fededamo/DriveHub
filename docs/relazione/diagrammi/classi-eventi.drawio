        <mxCell id="note" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Lettura della tavola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;Observer e publisher ricevono la Connection JDBC del chiamante come parametro.&lt;br&gt;La notifica è sincrona; l&amp;#x27;errore si propaga e impedisce il commit del servizio.&lt;br&gt;L&amp;#x27;evento conserva solo vehicleId. L&amp;#x27;observer cancella i test drive futuri del veicolo.&lt;br&gt;AppContext registra l&amp;#x27;observer; non sono previsti coda, outbox o eventi persistenti.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1010" width="920" height="180" />
