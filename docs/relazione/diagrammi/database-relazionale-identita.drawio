    </mxCell>
    <mxCell id="v13" value="UNION ALL di client / salesman / manager: id, name, surname, email, hash_password&lt;br&gt;+ role costante CLIENT / SALESMAN / MANAGER, scelto dal ramo della vista" style="text;strokeColor=none;fillColor=#f7f9fa;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="837" width="920" height="67" as="geometry" />
    </mxCell>
    <mxCell id="v14" value="Trigger BEFORE INSERT / UPDATE OF email cercano l&amp;#x27;email esatta nelle altre tabelle, escludendo lo stesso id. Non c&amp;#x27;è UNIQUE globale né vincolo globale sugli id.&lt;br&gt;La sequenza comune alimenta gli inserimenti ordinari; i trigger non sono una prova di esclusione fra scritture concorrenti. I ruoli della vista sono ruoli applicativi, non PostgreSQL." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=20;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
