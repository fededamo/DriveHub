    <mxCell id="v5" value="id BIGINT PK DEFAULT nextval(&amp;#x27;user_id_seq&amp;#x27;)&lt;br&gt;name, surname VARCHAR(50) · email VARCHAR(50) CK · hash_password VARCHAR(255)&lt;br&gt;CHECK email LIKE &amp;#x27;%_@_%._%&amp;#x27; (forma minima, non verifica dell&amp;#x27;indirizzo)" style="text;strokeColor=none;fillColor=#f7f9fa;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
