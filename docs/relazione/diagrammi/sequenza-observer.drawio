    <mxCell id="v20" value="La c è quella del chiamante, già in transazione. L&amp;#x27;evento contiene solo vehicleId, non l&amp;#x27;oggetto Vehicle né una Connection propria. AppContext registra questo observer nel publisher." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
