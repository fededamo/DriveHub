    <mxCell id="v33" value="Ritorno al servizio → ritorno della callback → DatabaseManager.commit(c). L&amp;#x27;Observer non esegue commit e non apre una nuova transazione. Conserva test drive già trascorsi; elimina tutti i futuri, anche fuori dal noleggio." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="8" y="941" width="940" height="84" as="geometry" />
    </mxCell>
    <mxCell id="v34" value="alt [SQLException nel DELETE] PostgresTestDriveDao la avvolge in RuntimeException; risale attraverso observer e publisher senza recupero locale; DatabaseManager tenta rollback della c del saldo/noleggio." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="8" y="1033" width="940" height="84" as="geometry" />
    </mxCell>
    <mxCell id="v35" value="Notifica sincrona prima del commit: nessuna freccia asincrona, coda, outbox o garanzia distribuita. Il publisher scorre gli osservatori registrati nello stesso thread.&lt;br&gt;Se il rollback fallisce, DatabaseManager conserva la SQLException come soppressa sulla causa. Guasti di apertura/chiusura e commit incerto non diventano una garanzia di recupero totale." style="text;strokeColor=none;fillColor=#f0f3f5;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="10" y="1159" width="940" height="150" as="geometry" />
    </mxCell>
