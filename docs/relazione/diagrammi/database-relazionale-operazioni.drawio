    <mxCell id="v2" value="REL-03 · Richieste, prenotazioni e registro" style="text;strokeColor=none;fillColor=none;fontColor=#172b3a;fontSize=27;fontStyle=1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="10" y="8" width="940" height="48" as="geometry" />
    </mxCell>
    <mxCell id="v3" value="PK = primaria; CK = candidata alternativa; FK → riferimento; ? = nullable; UQ = UNIQUE. Tutti gli altri attributi sono NOT NULL." style="text;strokeColor=none;fillColor=none;fontColor=#172b3a;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="65" width="920" height="68" as="geometry" />
    </mxCell>
    <mxCell id="v4" value="request" style="rounded=0;strokeColor=#647a8c;fillColor=#dcebf5;fontSize=23;spacing=8;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="155" width="920" height="45" as="geometry" />
    </mxCell>
    <mxCell id="v5" value="id BIGINT PK identity · vehicle BIGINT CK/FK → vehicle.id&lt;br&gt;client BIGINT FK → client.id · salesman BIGINT ? FK → salesman.id&lt;br&gt;deposit DECIMAL(10,2) · agreed_total DECIMAL(10,2) ? · exp_date DATE ?&lt;br&gt;type request_type · CHECK SALE: 0 ≤ deposit ≤ agreed_total, totale non nullo&lt;br&gt;CHECK PURCHASE: deposit ≥ 0 e agreed_total IS NULL · tutte le FK DELETE RESTRICT" style="text;strokeColor=none;fillColor=#f7f9fa;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="200" width="920" height="160" as="geometry" />
    </mxCell>
    <mxCell id="v6" value="test_drive" style="rounded=0;strokeColor=#647a8c;fillColor=#dcebf5;fontSize=23;spacing=8;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="384" width="920" height="45" as="geometry" />
    </mxCell>
    <mxCell id="v7" value="id BIGINT PK identity · vehicle BIGINT FK → vehicle.id · client BIGINT FK → client.id&lt;br&gt;date TIMESTAMP · CK (vehicle, date) · CHECK ora fra 09:00 e 16:00 inclusi&lt;br&gt;FK DELETE RESTRICT · nessun CHECK SQL su futuro, minuti o massimo tre attivi" style="text;strokeColor=none;fillColor=#f7f9fa;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="429" width="920" height="98" as="geometry" />
    </mxCell>
    <mxCell id="v8" value="rent" style="rounded=0;strokeColor=#647a8c;fillColor=#dcebf5;fontSize=23;spacing=8;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="551" width="920" height="45" as="geometry" />
    </mxCell>
    <mxCell id="v9" value="id BIGINT PK identity · vehicle BIGINT FK → vehicle.id · client BIGINT FK → client.id&lt;br&gt;amount DECIMAL(10,2) ≥ 0 · start DATE · end DATE · CHECK end ≥ start&lt;br&gt;EXCLUDE USING gist (vehicle WITH =, daterange(start, end, &amp;#x27;[]&amp;#x27;) WITH &amp;amp;&amp;amp;)&lt;br&gt;FK DELETE RESTRICT · estremi inclusivi; btree_gist supporta l&amp;#x27;esclusione per veicolo" style="text;strokeColor=none;fillColor=#f7f9fa;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="596" width="920" height="129" as="geometry" />
    </mxCell>
    <mxCell id="v10" value="sale" style="rounded=0;strokeColor=#647a8c;fillColor=#dcebf5;fontSize=23;spacing=8;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="749" width="920" height="45" as="geometry" />
    </mxCell>
    <mxCell id="v11" value="id BIGINT PK identity · vehicle BIGINT ? FK → vehicle.id DELETE SET NULL&lt;br&gt;salesman BIGINT ? FK → salesman.id DELETE RESTRICT&lt;br&gt;client BIGINT FK → client.id DELETE RESTRICT · amount DECIMAL(10,2) ≥ 0&lt;br&gt;date TIMESTAMP · type sale_type · nessun CHECK SQL sui riferimenti per tipo" style="text;strokeColor=none;fillColor=#f7f9fa;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="794" width="920" height="129" as="geometry" />
    </mxCell>
    <mxCell id="v12" value="identity = GENERATED BY DEFAULT AS IDENTITY. Tutte le FK non citate come CASCADE/SET NULL sono RESTRICT in DELETE; in UPDATE sono NO ACTION.&lt;br&gt;Lo schema non collega sale a request: l&amp;#x27;esito registra e poi elimina la richiesta. Nessun CHECK SQL impone il 20%, un mese, il futuro delle date o la coerenza fra stato e operazioni." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=20;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="952" width="920" height="140" as="geometry" />
    </mxCell>
  </root>
