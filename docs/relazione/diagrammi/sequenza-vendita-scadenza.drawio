    <mxCell id="v45" value="end alt · DatabaseManager: commit/chiusura c; aggiunge il messaggio solo dopo il ritorno. Fine loop: lista alla vista. Errore: rollback del solo candidato corrente e uscita dal metodo." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
