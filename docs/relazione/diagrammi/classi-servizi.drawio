        </mxCell>
        <mxCell id="subtitle" value="Package it.unifi.drivehub.service. I tipi esterni restano attributi o riferimenti qualificati." style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="55" width="1000" height="48" />
        </mxCell>
        <mxCell id="auth" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;AuthService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− userDao: UserDao&lt;br&gt;− bankAccountDao: BankAccountDao&lt;br&gt;− hasher: PasswordHasher&lt;br&gt;+ login(email, password)&lt;br&gt;+ registerClient(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="120" width="480" height="200" />
        </mxCell>
        <mxCell id="td" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;TestDriveService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− testDriveDao: TestDriveDao&lt;br&gt;− vehicleDao: VehicleDao&lt;br&gt;− userDao: UserDao&lt;br&gt;+ bookTestDrive(...)&lt;br&gt;+ cancelTestDrive(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="120" width="480" height="200" />
        </mxCell>
        <mxCell id="p" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;PurchaseService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− priceCalculator: PriceCalculatorService&lt;br&gt;+ initiatePurchase(...)&lt;br&gt;+ approvePurchase(...)&lt;br&gt;+ completePurchase(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="370" width="480" height="180" />
        </mxCell>
        <mxCell id="s" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;SaleToDealershipService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− priceCalculator: PriceCalculatorService&lt;br&gt;+ submitSaleProposal(...)&lt;br&gt;+ approveSaleProposal(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="370" width="480" height="180" />
        </mxCell>
        <mxCell id="r" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;RentalService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− priceCalculator: PriceCalculatorService&lt;br&gt;+ bookRental(...)&lt;br&gt;+ changeVehicleRentalState(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="600" width="480" height="170" />
        </mxCell>
        <mxCell id="calc" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;PriceCalculatorService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;+ calculateVehiclePrice(...)&lt;br&gt;+ calculatePurchaseDeposit(...)&lt;br&gt;+ calculateTotalRentalCost(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="600" width="480" height="170" />
        </mxCell>
        <mxCell id="catalog" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;CatalogService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− priceCalculator: PriceCalculatorService&lt;br&gt;+ getVehicleRows(state)&lt;br&gt;+ updateVehiclePricing(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="820" width="480" height="180" />
        </mxCell>
        <mxCell id="q" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;OperationQueryService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− requestDao: RequestDao&lt;br&gt;− testDriveDao: TestDriveDao&lt;br&gt;− rentDao: RentDao; saleDao: SaleDao&lt;br&gt;+ getClientRequests(clientId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="820" width="480" height="180" />
        </mxCell>
        <mxCell id="obs" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;TestDriveCancellationObserver&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− testDriveDao: TestDriveDao&lt;br&gt;+ onVehicleCommitted(event, conn)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1050" width="480" height="150" />
        </mxCell>
        <mxCell id="rows" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;nota&amp;raquo;&lt;br&gt;Record annidati di CatalogService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;VehicleRow(Vehicle, nomi e prezzi)&lt;br&gt;ModelDiscountRow(ModelDiscount, nome)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="1050" width="480" height="150" />
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Lettura della tavola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;DatabaseManager è un campo di tutti i servizi sopra, salvo calcolatore, query e observer.&lt;br&gt;Purchase, cessione e noleggio usano DAO veicoli, modelli, sconti, conti e operazioni.&lt;br&gt;Purchase e Rental conservano anche eventPublisher: VehicleEventPublisher.&lt;br&gt;Observer realizza event.VehicleCommitmentObserver (CL-07).&lt;br&gt;I campi priceCalculator mostrano riferimenti condivisi, senza composizione UML.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1270" width="1000" height="205" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>