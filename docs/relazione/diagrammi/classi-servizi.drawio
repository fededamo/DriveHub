        <mxCell id="title" value="CL-06 — Servizi e collaborazioni" style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontStyle=1;spacing=4;html=1;" vertex="1" parent="1">
