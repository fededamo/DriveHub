    <mxCell id="v46" value="ref SQ-OB · Notifica e cancellazioni test drive sincrone su c3; al ritorno DatabaseManager esegue commit e chiude c3. Soltanto dopo la vista mostra il successo." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
