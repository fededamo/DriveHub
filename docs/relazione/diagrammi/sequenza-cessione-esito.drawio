    </mxCell>
    <mxCell id="v42" value="end alt · I DAO eseguono SQL su c7. DatabaseManager commit e chiusura prima del successo UI; su Exception tenta rollback e propaga RuntimeException alla vista. Nessun Observer in T7." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="8" y="1331" width="940" height="84" as="geometry" />
    </mxCell>
    <mxCell id="v43" value="Il registro type PURCHASE conserva un esborso della concessionaria con importo non negativo; l&amp;#x27;accredito al cliente avviene solo qui, nella stessa transazione.&lt;br&gt;Limite attuale: Request ammette stima zero ma BankAccount.deposit richiede &amp;gt; 0; in quel caso l&amp;#x27;accettazione fallisce e torna in rollback (difetto separato, non corretto)." style="text;strokeColor=none;fillColor=#f0f3f5;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="10" y="1457" width="940" height="150" as="geometry" />
    </mxCell>
