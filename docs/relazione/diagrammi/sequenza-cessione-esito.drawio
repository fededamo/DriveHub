    <mxCell id="v41" value="alt [con storico] updateStateAtomically(vehicleId, WAITING, SOLD, c7); else [senza storico] PostgresVehicleDao.delete(vehicleId, c7). Nessun movimento sul conto né nuova riga sale." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
