<?xml version='1.0' encoding='utf-8'?>
<mxfile host="draw.io" version="32.6.10">
  <diagram id="classi-operazioni" name="CL-05 — Richieste, prenotazioni e registro">
    <mxGraphModel page="0" pageScale="1" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CL-05 — Richieste, prenotazioni e registro" style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontStyle=1;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="12" width="920" height="38" />
        </mxCell>
        <mxCell id="subtitle" value="Package it.unifi.drivehub.domain.operation. I nomi SALE/PURCHASE seguono la concessionaria." style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="55" width="920" height="48" />
        </mxCell>
        <mxCell id="req" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Request&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− vehicleId, clientId: Long {ID}&lt;br&gt;− salesmanId: Long [0..1] {ID}&lt;br&gt;− deposit: BigDecimal&lt;br&gt;− agreedTotal: BigDecimal [0..1]&lt;br&gt;− expDate: LocalDate [0..1]&lt;br&gt;+ createNewSaleRequest(...)&lt;br&gt;+ createNewPurchaseRequest(...)&lt;br&gt;+ getRemainingAmount()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="120" width="450" height="340" />
        </mxCell>
        <mxCell id="rt" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;enumeration&amp;raquo;&lt;br&gt;RequestType&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;SALE: vendita al cliente&lt;br&gt;PURCHASE: acquisto dal cliente&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="170" width="390" height="150" />
        </mxCell>
        <mxCell id="edge-1" value="type [1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;endArrow=open;endFill=0;" edge="1" source="req" target="rt" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sale" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Sale&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− vehicleId, salesmanId: Long [0..1] {ID}&lt;br&gt;− clientId: Long {ID}&lt;br&gt;− amount: BigDecimal {≥ 0}&lt;br&gt;− date: LocalDateTime&lt;br&gt;+ createSaleRecord(...)&lt;br&gt;+ createPurchaseRecord(...)&lt;br&gt;+ createPenaltyRecord(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="550" width="450" height="300" />
        </mxCell>
        <mxCell id="st" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;enumeration&amp;raquo;&lt;br&gt;SaleType&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;SALE, PURCHASE, PENALTY&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="570" width="390" height="110" />
        </mxCell>
        <mxCell id="edge-2" value="type [1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;endArrow=open;endFill=0;" edge="1" source="sale" target="st" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="rent" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Rent&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− vehicleId, clientId: Long {ID}&lt;br&gt;− amount: BigDecimal {≥ 0}&lt;br&gt;− startDate, endDate: LocalDate&lt;br&gt;+ overlapsWith(start, end)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="950" width="450" height="210" />
        </mxCell>
        <mxCell id="td" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;TestDrive&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− vehicleId, clientId: Long {ID}&lt;br&gt;− date: LocalDateTime&lt;br&gt;+ isFuture()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="950" width="390" height="170" />
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Lettura della tavola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;Nessun riferimento a oggetti Client, Vehicle o Salesman: solo identificativi.&lt;br&gt;Request.SALE: 0 ≤ deposit ≤ agreedTotal; saldo = totale − acconto.&lt;br&gt;Request.PURCHASE: deposit è la stima; agreedTotal è nullo. Sale è il registro economico.&lt;br&gt;Il 20% è una regola del servizio; gli stati commerciali appartengono a Vehicle.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1240" width="920" height="180" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>