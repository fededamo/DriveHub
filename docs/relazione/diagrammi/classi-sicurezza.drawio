        <mxCell id="title" value="CL-11 — Credenziali" style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontStyle=1;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="12" width="920" height="38" />
        </mxCell>
        <mxCell id="subtitle" value="Package it.unifi.drivehub.security. Contratto ristretto al trattamento delle password." style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="55" width="920" height="48" />
        </mxCell>
        <mxCell id="iface" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;interface&amp;raquo;&lt;br&gt;PasswordHasher&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;+ hash(rawPassword): String&lt;br&gt;+ verify(rawPassword, encodedHash): boolean&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="140" width="600" height="160" />
        </mxCell>
        <mxCell id="impl" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Pbkdf2PasswordHasher&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− iterations: int&lt;br&gt;− saltBytes: int&lt;br&gt;− keyBits: int&lt;br&gt;− random: SecureRandom&lt;br&gt;+ hash(rawPassword): String&lt;br&gt;+ verify(rawPassword, encodedHash): boolean&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="500" width="600" height="280" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;dashed=1;endArrow=block;endFill=0;" edge="1" source="impl" target="iface" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Lettura della tavola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:18.9px;white-space:nowrap&quot;&gt;AuthService conserva PasswordHasher; AppContext sceglie Pbkdf2PasswordHasher.&lt;br&gt;PBKDF2WithHmacSHA256, sale casuale e parametri memorizzati nella stringa codificata.&lt;br&gt;Questa astrazione non è un sistema di autorizzazione: la navigazione per ruolo è in User/App.&lt;br&gt;I servizi non ricevono tutti un&amp;#x27;identità autenticata da verificare a ogni invocazione.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="900" width="920" height="180" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>