        </mxCell>
        <mxCell id="subtitle" value="Package it.unifi.drivehub.domain.vehicle. I collegamenti per chiave restano attributi." style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="55" width="920" height="48" />
        </mxCell>
        <mxCell id="brand" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Brand&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− name: String&lt;br&gt;+ create(name)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="120" width="360" height="130" />
        </mxCell>
        <mxCell id="model" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− id: Long&lt;br&gt;− brand: String {chiave}&lt;br&gt;− releasePrice: BigDecimal&lt;br&gt;− releaseYear: int&lt;br&gt;+ create(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="120" width="430" height="220" />
        </mxCell>
        <mxCell id="v" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Vehicle&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;− id: Long&lt;br&gt;− modelId: Long {ID}&lt;br&gt;− vin: String&lt;br&gt;− licencePlate: String [0..1]&lt;br&gt;− kilometers: int&lt;br&gt;− price: BigDecimal {base}&lt;br&gt;+ getSelectedBasePrice(Model)&lt;br&gt;+ setPrice(amount)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="430" width="430" height="320" />
        </mxCell>
        <mxCell id="state" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;enumeration&amp;raquo;&lt;br&gt;VehicleState&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;SALE, RENT, BLOCKED&lt;br&gt;WAITING, SOLD&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="450" width="360" height="120" />
        </mxCell>
        <mxCell id="price" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;enumeration&amp;raquo;&lt;br&gt;PriceMode&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;AUTOMATIC&lt;br&gt;MANUAL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="660" width="360" height="120" />
        </mxCell>
        <mxCell id="edge-1" value="state [1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;endArrow=open;endFill=0;" edge="1" source="v" target="state" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-2" value="priceMode [1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;endArrow=open;endFill=0;" edge="1" source="v" target="price" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-3" value="getSelectedBasePrice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;dashed=1;endArrow=open;endFill=0;" edge="1" source="v" target="model" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Lettura della tavola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;modelId non è un oggetto Model; Model.brand è una stringa, non un oggetto Brand.&lt;br&gt;La dipendenza Vehicle → Model deriva dal parametro del metodo di scelta della base.&lt;br&gt;Vincoli locali: km ≥ 0; senza targa km = 0; base ≥ 0; anno fra 1900 e oggi.&lt;br&gt;MANUAL sostituisce la base nella formula; non fissa il totale finale (ADR 0001).&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="870" width="920" height="180" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
