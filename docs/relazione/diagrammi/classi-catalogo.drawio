        <mxCell id="title" value="CL-03 — Catalogo e scelta della base" style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontStyle=1;spacing=4;html=1;" vertex="1" parent="1">
