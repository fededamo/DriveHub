    <mxCell id="v37" value="else [VIN nuovo] PostgresModelDao.findById(modelId) apre c0 autonoma per la base; Vehicle.create(..., WAITING); PostgresVehicleDao.save(newVehicle, c6). Non c&amp;#x27;è un lock di un VIN assente." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
