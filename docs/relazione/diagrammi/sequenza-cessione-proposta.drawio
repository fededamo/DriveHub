    <mxCell id="v36" value="«guardie» ultima SALE al proponente, nessuna richiesta, modelId/anno coincidenti. «memoria» aggiorna targa, km, WAITING; PostgresVehicleDao.update(vehicle, c6)." style="text;strokeColor=none;fillColor=#fff7df;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
