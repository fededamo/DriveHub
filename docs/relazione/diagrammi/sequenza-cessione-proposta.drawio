    </mxCell>
    <mxCell id="v44" value="Errore: tentativo di rollback c6, comprese creazione/aggiornamento del veicolo. submitSaleProposal riespone IllegalArgumentException/IllegalStateException avvolte, altrimenti rilancia il failure.&lt;br&gt;La stima persistita fissa l&amp;#x27;importo dell&amp;#x27;eventuale esito positivo; non è ancora una registrazione economica." style="text;strokeColor=none;fillColor=#f0f3f5;fontColor=#172b3a;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
