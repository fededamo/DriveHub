  <diagram id="classi-transazioni" name="CL-08b — Gestione delle transazioni">
    <mxGraphModel page="0" pageScale="1" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CL-08b — Gestione delle transazioni" style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontStyle=1;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="12" width="1000" height="38" />
        </mxCell>
        <mxCell id="subtitle" value="Package it.unifi.drivehub.dao. Tipi annidati qualificati con DatabaseManager." style="text;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;spacing=4;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="55" width="1000" height="48" />
        </mxCell>
        <mxCell id="db" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;DatabaseManager&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;+ getConnection(): Connection&lt;br&gt;+ executeInTransaction(TransactionConsumer)&lt;br&gt;+ executeInTransactionWithResult(TransactionFunction&amp;lt;T&amp;gt;): T&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="160" width="1000" height="170" />
        </mxCell>
        <mxCell id="tc" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;interface&amp;raquo;&lt;br&gt;DatabaseManager.&lt;br&gt;TransactionConsumer&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;+ execute(conn): void throws Exception&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="500" width="480" height="155" />
        </mxCell>
        <mxCell id="tf" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;&amp;laquo;interface&amp;raquo;&lt;br&gt;DatabaseManager.&lt;br&gt;TransactionFunction&amp;lt;T&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;+ execute(conn): T throws Exception&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="500" width="480" height="155" />
        </mxCell>
        <mxCell id="edge-1" value="parametro" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;dashed=1;endArrow=open;endFill=0;" edge="1" source="db" target="tc" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-2" value="parametro" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;strokeColor=#334155;dashed=1;endArrow=open;endFill=0;" edge="1" source="db" target="tf" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;text-align:center;font-size:21.0px;white-space:nowrap&quot;&gt;&lt;b&gt;Lettura della tavola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:19.0px;white-space:nowrap&quot;&gt;I DAO non estendono DatabaseManager: i contratti espongono entità e JDBC.&lt;br&gt;Le due interfacce annidate sono callback del corpo transazionale, non DAO aggiuntivi.&lt;br&gt;Non tutti gli overload conn dei contratti garantiscono da soli il riuso: alcuni default&lt;br&gt;delegano alla lettura senza conn; le implementazioni PostgreSQL pertinenti li ridefiniscono.&lt;br&gt;Il gestore apre la connessione, disabilita autocommit e tenta commit o rollback.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#475569;spacing=9;fontFamily=Arial;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="780" width="1000" height="205" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>