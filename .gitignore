# Maven and local verification caches
/target/
/.m2/
/.verify-maven/
/.verify-latex/

# IDE files (keep the shared VS Code tasks)
/.idea/
/.vscode/*
!/.vscode/tasks.json
*.iml
.classpath
.project
.settings/

# Local configuration and Python caches
.env
.env.*
!.env.example
/.venv/
__pycache__/
*.py[cod]

# Diagrams rendered from the tracked PlantUML sources
/docs/diagrams/rendered/

# Logs and operating-system files
*.log
!docs/evidence/**/maven.log
hs_err_pid*
replay_pid*
.DS_Store
Thumbs.db
Desktop.ini
