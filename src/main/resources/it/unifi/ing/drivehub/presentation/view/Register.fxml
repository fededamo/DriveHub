<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unifi.ing.drivehub.presentation.controller.RegistrationController"
           stylesheets="@../css/style.css" styleClass="auth-shell"
           prefWidth="1100" prefHeight="760">
    <VBox styleClass="card,auth-card" alignment="CENTER" spacing="13">
        <HBox alignment="CENTER" spacing="10">
            <Label text="⌁" styleClass="brand-mark"/>
            <Label text="DriveHub" styleClass="brand-name"/>
        </HBox>
        <Label text="Crea account" styleClass="page-title"/>
        <GridPane styleClass="form-grid">
            <Label text="Nome" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="firstNameField" promptText="Mario" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Cognome" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="lastNameField" promptText="Rossi" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" promptText="mario.rossi@esempio.it" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Password" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Ruolo" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <ComboBox fx:id="roleCombo" promptText="Seleziona un ruolo" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>
        </GridPane>
        <Label text="Per i clienti verrà generato automaticamente un conto corrente con IBAN e saldo iniziale."
               wrapText="true" styleClass="muted"/>
        <Label fx:id="errorLabel" styleClass="danger-text" wrapText="true"/>
        <Button text="REGISTRATI" onAction="#register" styleClass="primary-button" maxWidth="Infinity"/>
        <Button text="Torna all'accesso" onAction="#openLogin" styleClass="secondary-button"/>
    </VBox>
</StackPane>
