<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unifi.ing.drivehub.presentation.controller.LoginController"
           stylesheets="@../css/style.css" styleClass="auth-shell"
           prefWidth="1100" prefHeight="720">
    <VBox styleClass="card,auth-card" alignment="CENTER" spacing="16">
        <HBox alignment="CENTER" spacing="10">
            <Label text="⌁" styleClass="brand-mark"/>
            <Label text="DriveHub" styleClass="brand-name"/>
        </HBox>
        <Label text="Accedi" styleClass="page-title"/>
        <Label text="Inserisci le credenziali del tuo account" styleClass="muted"/>
        <VBox spacing="6" fillWidth="true">
            <Label text="EMAIL"/>
            <TextField fx:id="emailField" promptText="nome@esempio.test"/>
        </VBox>
        <VBox spacing="6" fillWidth="true">
            <Label text="PASSWORD"/>
            <PasswordField fx:id="passwordField" promptText="Password" onAction="#login"/>
        </VBox>
        <Label fx:id="errorLabel" styleClass="danger-text" wrapText="true"/>
        <Button text="ACCEDI" onAction="#login" styleClass="primary-button" maxWidth="Infinity"/>
        <HBox alignment="CENTER" spacing="8">
            <Button text="Indietro" onAction="#back" styleClass="secondary-button"/>
            <Button text="Crea account" onAction="#openRegistration" styleClass="secondary-button"/>
        </HBox>
    </VBox>
</StackPane>
