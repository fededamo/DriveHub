<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unifi.ing.drivehub.presentation.controller.SalesmanWorkspaceController"
            stylesheets="@../css/style.css" prefWidth="1280" prefHeight="800">
    <top>
        <HBox styleClass="app-header">
            <Label text="⌁" styleClass="brand-mark"/><Label text="DriveHub" styleClass="brand-name"/>
            <Region HBox.hgrow="ALWAYS"/><Label fx:id="userLabel" text="Venditore"/>
            <Button text="Aggiorna" onAction="#refresh" styleClass="secondary-button"/>
            <Button text="Logout" onAction="#logout" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content" spacing="12">
            <Label text="Area Venditore" styleClass="page-title"/>
            <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <!-- TAB 1: VEICOLI PROPOSTI IN ATTESA DI APPROVAZIONE -->
                    <Tab text="Veicoli in attesa di approvazione (WAITING)">
                        <VBox styleClass="content" spacing="10">
                            <Label text="Veicoli proposti dai clienti da valutare per la compravendita o immissione a catalogo" styleClass="section-title"/>
                            <TableView fx:id="waitingVehiclesTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="waitingPlateColumn" text="Targa" prefWidth="120"/>
                                    <TableColumn fx:id="waitingVinColumn" text="VIN (Telaio)" prefWidth="180"/>
                                    <TableColumn fx:id="waitingModelColumn" text="Modello" prefWidth="280"/>
                                    <TableColumn fx:id="waitingYearColumn" text="Anno" prefWidth="90"/>
                                    <TableColumn fx:id="waitingKmColumn" text="Km" prefWidth="100"/>
                                    <TableColumn fx:id="waitingPriceColumn" text="Prezzo Valutato (€)" prefWidth="160"/>
                                </columns>
                            </TableView>
                            <FlowPane styleClass="toolbar" hgap="10" vgap="10">
                                <Button text="Approva Proposta (Acquista dal cliente / Metti in VENDITA)" onAction="#approveWaitingVehicle" styleClass="primary-button"/>
                                <Button text="Rifiuta Proposta (Rifiuta e Rimuovi)" onAction="#rejectWaitingVehicle" styleClass="danger-button"/>
                            </FlowPane>
                        </VBox>
                    </Tab>

                    <!-- TAB 2: RICHIESTE CLIENTI -->
                    <Tab text="Richieste Clienti e Sblocco Saldo">
                        <VBox styleClass="content" spacing="10">
                            <Label text="Richieste con acconto versato (20%): autorizza per impostare la scadenza di pagamento a 1 mese" styleClass="section-title"/>
                            <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="reqIdColumn" text="ID" prefWidth="70"/>
                                    <TableColumn fx:id="reqVehicleColumn" text="Veicolo" prefWidth="280"/>
                                    <TableColumn fx:id="reqTypeColumn" text="Tipo Richiesta" prefWidth="180"/>
                                    <TableColumn fx:id="reqClientColumn" text="Cliente" prefWidth="130"/>
                                    <TableColumn fx:id="reqDepositColumn" text="Acconto / Stima (€)" prefWidth="160"/>
                                    <TableColumn fx:id="reqExpDateColumn" text="Scadenza Saldo" prefWidth="180"/>
                                </columns>
                            </TableView>
                            <FlowPane styleClass="toolbar" hgap="10" vgap="10">
                                <Button text="Autorizza Richiesta Acquisto (Scadenza 1 mese)" onAction="#authorizePurchaseRequest" styleClass="primary-button"/>
                            </FlowPane>
                        </VBox>
                    </Tab>

                    <!-- TAB 3: CAMBIO STATO VEICOLI -->
                    <Tab text="Gestione Stato Veicoli (VENDITA / NOLEGGIO)">
                        <VBox styleClass="content" spacing="10">
                            <Label text="Attiva la modalità vendita (SALE) o noleggio (RENT) per i veicoli" styleClass="section-title"/>
                            <TableView fx:id="availableVehiclesTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="availPlateColumn" text="Targa" prefWidth="120"/>
                                    <TableColumn fx:id="availVinColumn" text="VIN (Telaio)" prefWidth="180"/>
                                    <TableColumn fx:id="availModelColumn" text="Modello" prefWidth="300"/>
                                    <TableColumn fx:id="availPriceColumn" text="Prezzo Base (€)" prefWidth="140"/>
                                    <TableColumn fx:id="availStateColumn" text="Stato Attuale" prefWidth="140"/>
                                </columns>
                            </TableView>
                            <FlowPane styleClass="toolbar" hgap="10" vgap="10">
                                <Button text="Imposta su NOLEGGIO (RENT)" onAction="#switchToRent" styleClass="secondary-button"/>
                                <Button text="Imposta su VENDITA (SALE) - Annulla e rimborsa noleggi futuri" onAction="#switchToSale" styleClass="primary-button"/>
                            </FlowPane>
                        </VBox>
                    </Tab>

                    <!-- TAB 4: NOLEGGI E TEST DRIVE -->
                    <Tab text="Panoramica noleggi e test drive">
                        <VBox styleClass="content" spacing="12">
                            <Label text="Noleggi registrati" styleClass="section-title"/>
                            <TableView fx:id="rentalsTable" prefHeight="230">
                                <columns>
                                    <TableColumn fx:id="rentalVehicleColumn" text="Veicolo" prefWidth="320"/>
                                    <TableColumn fx:id="rentalPeriodColumn" text="Periodo noleggio" prefWidth="240"/>
                                    <TableColumn fx:id="rentalAmountColumn" text="Importo Incassato (€)" prefWidth="180"/>
                                </columns>
                            </TableView>

                            <Separator/>
                            <Label text="Test drive prenotati" styleClass="section-title"/>
                            <TableView fx:id="testDrivesTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="tdVehicleColumn" text="Veicolo" prefWidth="300"/>
                                    <TableColumn fx:id="tdClientColumn" text="Cliente" prefWidth="140"/>
                                    <TableColumn fx:id="tdDateColumn" text="Data" prefWidth="140"/>
                                    <TableColumn fx:id="tdTimeColumn" text="Ora inizio" prefWidth="140"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- TAB 5: GESTIONE PROFILO E ACCOUNT -->
                    <Tab text="Profilo e Account">
                        <VBox styleClass="content" spacing="14">
                            <Label text="Modifica Indirizzo Email" styleClass="section-title"/>
                            <GridPane styleClass="form-grid" hgap="10" vgap="10">
                                <Label text="Nuova Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="newEmailField" promptText="nuova@email.it" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Password attuale per conferma:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="emailCurrentPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Button text="Aggiorna Email" onAction="#updateEmail" styleClass="primary-button"/>

                            <Separator/>
                            <Label text="Modifica Password" styleClass="section-title"/>
                            <GridPane styleClass="form-grid" hgap="10" vgap="10">
                                <Label text="Password attuale:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="pwdCurrentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Nuova Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Button text="Aggiorna Password" onAction="#updatePassword" styleClass="primary-button"/>

                            <Separator/>
                            <Label text="Eliminazione Account Venditore" styleClass="section-title"/>
                            <Label text="L'account può essere eliminato solo se non hai vendite o operazioni associate nel registro storico." styleClass="muted"/>
                            <GridPane styleClass="form-grid" hgap="10" vgap="10">
                                <Label text="Password per conferma:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="deleteAccountPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Button text="Elimina il mio Account Venditore" onAction="#deleteAccount" styleClass="danger-button"/>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
